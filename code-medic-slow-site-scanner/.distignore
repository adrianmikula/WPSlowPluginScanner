# Files to exclude from WordPress.org plugin zip
# Hidden files
.gitignore
.distignore
.phpunit.result.cache
.env
.env.example
env-example

# Tests - run outside WordPress context, can't use WP_Filesystem
tests/
tests/bootstrap.php
tests/TestSyntax.php
tests/TestToggle.php

# Composer setup - not part of plugin functionality
composer-setup.php

# Development files (included via vendor but excluded from plugin zip)
.phpunit.xml
composer.json
composer.lock

# Documentation - not included in plugin zip
*.md
docs/

# Scripts and SQL - development/deployment only
*.sh
*.ps1
*.sql

# Vendor dependencies (WP tests use their own)
vendor/

# Premium add-ons (separate distribution)
premium/
