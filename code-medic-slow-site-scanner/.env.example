# Plugin mode: "free" or "premium"
CODEMEDSSS_MODE=free

# Number of plugins to scan in free mode (default: 3)
# Note: Free version is actually unlimited but this constant is required by tests
CODEMEDSSS_FREE_PLUGIN_LIMIT=3

# Premium upgrade URL (e.g., Gumroad link)
CODEMEDSSS_PREMIUM_URL=

# Supabase configuration for telemetry (premium only)
CODEMEDSSS_SUPABASE_URL=
CODEMEDSSS_SUPABASE_ANON_KEY=
CODEMEDSSS_SUPABASE_TABLE=telemetry
